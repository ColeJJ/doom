<scheme name="tj" version="142" parent_scheme="Obsidian">
  <!-- TJ DeVries' colorbuddy-Theme (aus tj-theme.el portiert) fuer IntelliJ IDEA.
       Import: Settings > Editor > Color Scheme > Zahnrad > Import Scheme... > diese Datei.
       Danach oben im Dropdown "tj" auswaehlen. Gelbe Funktionen, violette Keywords,
       kursive Typen/Kommentare, gruene Strings, rote Zahlen, orange Konstanten.
       OHNE eigenen Editor-Hintergrund: erbt via parent_scheme="Obsidian" den
       dunklen Hintergrund des Obsidian-Schemas; die tj-Syntaxfarben liegen oben drauf.
       Nutzt du ein anderes Editor-Schema, parent_scheme entsprechend anpassen
       (Name = wie im Dropdown "Editor > Color Scheme"). -->
  <metaInfo>
    <property name="created">2026-07-22</property>
    <property name="ide">idea</property>
    <property name="originalScheme">tj</property>
  </metaInfo>

  <colors>
